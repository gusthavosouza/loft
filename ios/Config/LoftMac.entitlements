<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight and the App Store take only sandboxed Mac apps. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Talks to Loft's API: this Mac's localhost, or another Mac over Tailscale. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Dictation and Talk. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Images picked to send in a chat. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- The paired token, shared with the desktop widgets. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(LOFT_BUNDLE_ID:default=com.example.loft).shared</string>
	</array>
</dict>
</plist>
