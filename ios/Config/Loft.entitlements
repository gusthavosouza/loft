<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode signs App Store / TestFlight exports with "production"; Debug builds use the sandbox. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Urgency-3 items ("blocks an agent now") break through Focus. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- The Loft address, shared with the home screen widgets. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(LOFT_BUNDLE_ID:default=com.example.loft).shared</string>
	</array>
</dict>
</plist>
